<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.mall</groupId>
    <artifactId>mall-common</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall-common</name>
    <description>微服务共享内核（非契约基础设施）：出站装配与头拦截器、traceId 过滤器、缓存/JSON/分页/时间工具、网关身份头常量。**不含**对外契约（ApiResponse/BusinessException/GlobalExceptionHandler/PageResult 仍由各服务自持，见《微服务代码规范.md》§6）</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- 出站 RestClient / servlet 过滤器 / @AutoConfiguration 的宿主 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- CacheService：StringRedisTemplate（Redis 不可用时 fail-open，见类注释） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- CacheService 的 @Slf4j -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- ⚠️ 刻意**不加** spring-boot-maven-plugin：本模块是库（被 8 个服务依赖），不是可执行应用。
                 打包产物按 Maven 默认的 `<artifactId>-<version>.jar`，供其它模块 `mvn -o install` 后解析。 -->
            <!--
                ⚠️ install 插件必须钉在 3.1.2：Boot 4.1.1 的 parent 默认 3.1.4，而它依赖
                maven-resolver-{api,util}:1.9.22 —— 本机离线仓库里那两个版本**只有 .pom 没有 .jar**
                ⇒ `mvn -o install` 会以 "Cannot access central ... in offline mode" 失败。
                3.1.2 依赖 1.9.18，本地仓库有完整 jar。锁在这里，换机器只要仓库同步过就不受影响。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-install-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
