<?xml version="1.0" encoding="UTF-8"?>
<!--
  mall-search：检索域服务（Elasticsearch 索引维护 + 商品检索）

  ⚠️ 骨架照 backend/mall-cloud/mall-marketing/pom.xml，版本组合逐字一致：
    Spring Boot 4.1.1 + Spring Cloud 2025.1.3 + Spring Cloud Alibaba 2025.1.0.0（Nacos 3.2.4）

  ⚠️ 本服务**没有自己的 MySQL 表**（规格 §1）：唯一存储是 Elasticsearch + 少量 Redis 兜底键
    （mall:es:pending）。所以这里**刻意没有** mybatis-plus / mysql-connector
    ——索引文档的内容一律**向 mall-product 拉**（/internal/v1/product/index-docs），
    绝不"读旧库、写新索引"。

  ⚠️ 与其它服务不同的一点：本服务**带 RabbitMQ**（沿用单体既有拓扑 mall.pms.sync /
    mall.pms.es-sync(+.retry/.dlq)）。理由见规格 §1.2/§3：拓扑名字与声明参数一个字都不许改
    （改名要两级同时改 + 声明参数必须与单体一致，P5 踩过 PRECONDITION_FAILED），
    而语义完全一样。**不新造 product.changed**；"发布方搬去 product"留到 P6-5。

  ⚠️ 依赖纪律（按编译驱动）：
    · spring-boot-starter-data-elasticsearch：单体的 ES 客户端（co.elastic.clients…ElasticsearchClient）
      就是由它传递进来的（单体没有自建 @Bean，靠自动装配 + spring.elasticsearch.* 属性）；
    · spring-cloud-starter-loadbalancer：要**出站调 product**（lb://mall-product）——P6-1 里
      mall-product 没搬它是因为它没有出站调用，本服务有，所以必须加；
    · Redis：只用于"待同步索引"兜底集合（与单体逐字同键 mall:es:pending）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.mall</groupId>
    <artifactId>mall-search</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall-search</name>
    <description>商城系统检索服务：Elasticsearch 索引维护与商品检索（无自有数据表）</description>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ES 客户端（co.elastic.clients:elasticsearch-java 由它传递进来，与单体同一条路径）；
             ⚠️ 不要换成裸 elasticsearch-java：单体的行为（含 SSL bundle、超时口径）就是这样来的 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-elasticsearch</artifactId>
        </dependency>

        <!-- RabbitMQ：商品索引同步通道（拓扑名与声明参数照抄单体，见规格 §1.2/§3） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Redis：**只用于**"待同步索引"兜底集合 mall:es:pending（与单体同一把 key） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- AOP：方法调用 debug 日志切面（与其它服务同一套，便于跨服务排查） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 注册中心：注册名 mall-search（P6-4 起网关按 lb://mall-search 路由；本批不切路由） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- 出站调用走服务发现：向 mall-product 拉索引文档内容 / 取品牌下在架 spu -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
            <!--
            代码规范闸门：《微服务代码规范.md》的可执行版本（命名后缀与包职责）。
            只用到核心 API（ClassFileImporter + ArchRule）⇒ 引 archunit 而非 archunit-junit5；
            与 mall-trade 的架构闸门（ModuleBoundaryTest）同一版本。
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.4.0</version>
            <scope>test</scope>
        </dependency>
        <!--
            v5.2：共享内核（非契约基础设施）。**没有**它就没有出站装配/头拦截器/traceId 过滤器/JSON、
            缓存、分页、时间工具与网关身份头常量。契约面（ApiResponse/BusinessException/
            GlobalExceptionHandler/PageResult）仍由本服务自持 —— 见《微服务代码规范.md》§6。
            构建顺序：先 `mvn -o install` mall-common（离线仓库依赖它），再构建本模块。
        -->
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading -Djdk.attach.allowAttachSelf=true</argLine>
                </configuration>
            </plugin>
            <!-- Lombok 注解处理器显式声明（JDK 21 起 javac 不再从 classpath 自动发现） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
