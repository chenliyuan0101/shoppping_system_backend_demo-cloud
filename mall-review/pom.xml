<?xml version="1.0" encoding="UTF-8"?>
<!--
  mall-review：评价服务（P4）

  版本组合沿用 P1 spike 实测锁定的组合（见《微服务改造方案.md》附录 E）：
    Spring Boot 4.1.1 + Spring Cloud 2025.1.3 + Spring Cloud Alibaba 2025.1.0.0 + Nacos 3.2.4

  ⚠️ 本服务**不依赖单体**（没有共享 jar）：
    共享内核（ApiResponse/BusinessException/GlobalExceptionHandler/CacheService…）与本服务的
    跨服务契约快照都是**本服务自持的副本**，放在 com.mall.review.support 下。
    理由见方案 §2.8/§4.10：跨服务共享 jar 会把"各自的演进"重新绑死，
    契约靠"逐字相同 + 契约测试"守，而不是靠同一个 class 文件。

  ⚠️ P4 第 1 批的范围：pom 一次到位（后面几个批次都要这些依赖），
    但**代码只做"能启动 + 注册 + 读自己的库"的最小竖直切片**：
    评价的读写业务逻辑仍在单体 pms（CommentServiceImpl/CommentController），尚未搬过来。
    本服务此刻对外只有 /internal/** 两个只读端点，网关也还没路由到它（本批不动网关）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.mall</groupId>
    <artifactId>mall-review</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall-review</name>
    <description>商城系统评价服务：商品评价的提交/展示/管理 + 待评价读模型</description>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.12</mybatis-plus.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 本服务自己的库：mall_review（pms_comment / review_pending_item，见 db/01-mall_review-schema.sql） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis：评论数/好评率的缓存与限流（与其它服务共用同一个 Redis 实例，key 前缀 mall:） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          RabbitMQ：消费 trade 的 order.finished 事件投影出 review_pending_item
          （方案 §4.5：用它替掉"提交评价时跨域查 oms_order + 跨域 CAS comment_status"）。
          P4 第 1 批**还没有**任何消费者与拓扑，`mall.mq.enabled` 默认 false，
          因此本服务此刻完全不连 broker——依赖先放进来，是为了下一批接线时不用再改 pom。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- AOP：方法调用 debug 日志切面（与单体/其它服务同一套，便于跨服务排查） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 注册中心：注册名 mall-review（网关按 lb://mall-review 路由；P4 第 1 批还没接路由） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- 出站调用也要走服务发现（后续批次 review → user-center 取昵称兜底、review → product 补商品图） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
            <!--
            代码规范闸门：《微服务代码规范.md》的可执行版本（命名后缀与包职责）。
            只用到核心 API（ClassFileImporter + ArchRule）⇒ 引 archunit 而非 archunit-junit5；
            与 mall-trade 的架构闸门（ModuleBoundaryTest）同一版本。
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.4.0</version>
            <scope>test</scope>
        </dependency>
        <!--
            v5.2：共享内核（非契约基础设施）。**没有**它就没有出站装配/头拦截器/traceId 过滤器/JSON、
            缓存、分页、时间工具与网关身份头常量。契约面（ApiResponse/BusinessException/
            GlobalExceptionHandler/PageResult）仍由本服务自持 —— 见《微服务代码规范.md》§6。
            构建顺序：先 `mvn -o install` mall-common（离线仓库依赖它），再构建本模块。
        -->
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading -Djdk.attach.allowAttachSelf=true</argLine>
                </configuration>
            </plugin>
            <!-- Lombok 注解处理器显式声明（JDK 21 起 javac 不再从 classpath 自动发现） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
