<?xml version="1.0" encoding="UTF-8"?>
<!--
  mall-user-center：用户中心服务（P3）

  版本组合沿用 P1 spike 实测锁定的组合（见《微服务改造方案.md》附录 E）：
    Spring Boot 4.1.1 + Spring Cloud 2025.1.3 + Spring Cloud Alibaba 2025.1.0.0 + Nacos 3.2.4

  ⚠️ 本服务**不依赖单体**（没有 common 包共享）：
    共享内核（ApiResponse/BusinessException/GlobalExceptionHandler/CacheService…）与跨服务契约快照
    （CategoryNode/ProductListItemVO/HomeFeedVO）都是**本服务自持的副本**，
    放在 com.mall.usercenter.support 下。理由见方案 §2.8/§4.10：
    跨服务共享 jar 会把"各自的演进"重新绑死，契约靠"逐字相同 + 契约测试"守，而不是靠同一个 class 文件。
    改动契约字段时必须两侧同时改，两侧都有断言守着 JSON 字段名。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.mall</groupId>
    <artifactId>mall-user-center</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mall-user-center</name>
    <description>商城系统用户中心：会员/登录态/地址/购物车/收藏/足迹/站内消息</description>

    <properties>
        <java.version>21</java.version>
        <mybatis-plus.version>3.5.12</mybatis-plus.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 本服务自己的库：mall_content（cms_banner / cms_notice） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- BCrypt 密码编码：只引 spring-security-crypto，不引入完整 Security 过滤器链 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Redis：令牌版本（登出/改密/禁用后主动失效） + 成员状态缓存（§4.4 ②） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          RabbitMQ：消费订单领域事件（order.paid / order.shipped / refund.settled）写站内消息。
          P3-5 起本服务是 ums_notification 的**唯一写入方**（单体那一份已删）。
          拓扑是"扇出"而不是"抢消息"：本服务声明**自己的**队列 mall.user.notification
          绑到单体发布的同一个交换机 mall.oms.event，因此事件会同时到达两个服务各自的队列
          （见 MqTopology 的注释：同名队列 = 竞争消费，会让通知或统计随机丢一半）。
          开关 mall.mq.enabled=false 时本服务的 MQ 装配与消费者都不装配 → 完全不连 RabbitMQ。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- MinIO：文件上传（P2 决策 1：对外鉴权留在单体，本服务只负责"存"） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.17</version>
        </dependency>

        <!-- AOP：方法调用 debug 日志切面（与单体同一套，便于跨服务排查） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 注册中心：注册名 mall-content（网关按 lb://mall-content 路由） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- 出站调用也要走服务发现：content → product 的 /internal/v1/product/home-feed -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
            <!--
            代码规范闸门：《微服务代码规范.md》的可执行版本（命名后缀与包职责）。
            只用到核心 API（ClassFileImporter + ArchRule）⇒ 引 archunit 而非 archunit-junit5；
            与 mall-trade 的架构闸门（ModuleBoundaryTest）同一版本。
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.4.0</version>
            <scope>test</scope>
        </dependency>
        <!--
            v5.2：共享内核（非契约基础设施）。**没有**它就没有出站装配/头拦截器/traceId 过滤器/JSON、
            缓存、分页、时间工具与网关身份头常量。契约面（ApiResponse/BusinessException/
            GlobalExceptionHandler/PageResult）仍由本服务自持 —— 见《微服务代码规范.md》§6。
            构建顺序：先 `mvn -o install` mall-common（离线仓库依赖它），再构建本模块。
        -->
        <dependency>
            <groupId>com.mall</groupId>
            <artifactId>mall-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading -Djdk.attach.allowAttachSelf=true</argLine>
                </configuration>
            </plugin>
            <!-- Lombok 注解处理器显式声明（JDK 21 起 javac 不再从 classpath 自动发现） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
